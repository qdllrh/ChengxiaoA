<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ChengxiaoA.ViewModels"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="700"
             x:Class="ChengxiaoA.Views.MainView"
             FontFamily="Noto Sans CJK,Roboto,Droid Sans Fallback,sans-serif">
    <ScrollViewer>
        <StackPanel Margin="10" Spacing="8">

            <!-- 标题（放在Border里以确保中文正常显示） -->
            <Border Background="Transparent" Padding="12,0,12,10">
                <TextBlock Text="成效计算器" FontSize="24"  HorizontalAlignment="Center" Foreground="#2E7D32" Name="titleTextBlock"/>
            </Border>

            <!-- 输入区域 -->
            <Border Background="White" CornerRadius="8" Padding="12">
                <StackPanel Spacing="12">
                    <TextBlock Text="📊 数据输入" FontSize="16"  Foreground="#555"/>

                    <!-- 行动 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="行动值" FontSize="14" Foreground="#666"/>
                        <TextBox Name="txtX" TextAlignment="Center" Height="45" FontSize="18" Background="#FFDFEADB" Watermark="输入行动值"/>
                    </StackPanel>

                    <!-- 思考 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="思考值" FontSize="14" Foreground="#666"/>
                        <TextBox Name="txtY" TextAlignment="Center" Height="45" FontSize="18" Background="#FFDFEADB" Watermark="输入思考值"/>
                    </StackPanel>

                    <!-- 结果比例 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="结果比例" FontSize="14" Foreground="#666"/>
                        <TextBox Name="txtZ" TextAlignment="Center" Height="45" FontSize="18" Background="#FFDFEADB" Watermark="输入比例"/>
                    </StackPanel>

                      <!-- 计算按钮 -->
                       <Grid ColumnDefinitions="*,*">
                        <StackPanel Spacing="4">
                     <Button Name="btnCalculate" Content=" 计算成效" Height="55" FontSize="18" 
                        Click="BtnCalculate_Click" Background="#4CAF50" Foreground="White" CornerRadius="8" Grid.Column="0"/>    
                     </StackPanel>
                           <TextBox Name="txtResult" TextAlignment="Center" Height="45" FontSize="18"
                                     IsReadOnly="True" Background="#F5F5F5" Watermark="计算结果"  Grid.Column="1"/>
                           </Grid>

                     <Grid ColumnDefinitions="*,*">
                      <Button Name="btnAccumulate" Grid.Column="0" Content="➕ 成效累计" Height="50" FontSize="16"
                            Click="BtnAccumulate_Click" Background="#66BB6A" Foreground="White" CornerRadius="8" Margin="0,0,4,0" IsEnabled="False"/>
                                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="成效累计" FontSize="14" Foreground="#666" />
                            <TextBox Name="txtTotal" TextAlignment="Center" Height="45" FontSize="18"
                                     IsReadOnly="True" Background="#F5F5F5" Watermark="累计成效"/>
                        </StackPanel>  
                    </Grid>
                    
                    <!-- 娱乐时间 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="娱乐时间" FontSize="14" Foreground="#666"/>
                        <TextBox Name="txtYleshijian" TextAlignment="Center" Height="45" FontSize="18" Background="#FFDFEADB" Watermark="输入娱乐时间"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*">
                    <Button Name="Yulebutton" Content="娱乐计算" Height="55" FontSize="18" Grid.Column="0"
                                    Click="Yulebutton_Click" Background="#8BC34A" Foreground="White" CornerRadius="6" Margin="5,0,0,0"/>
                    <TextBox Name="txtYule" TextAlignment="Center" Height="45" FontSize="18" Grid.Column="1"
                             IsReadOnly="True" Background="#F5F5F5" Watermark="娱乐结果"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,*">
                          <Button Name="Yuleleijibutton" Grid.Column="0" Content="➕ 娱乐累计" Height="50" FontSize="16"
                            Click="Yuleleijibutton_Click" Background="#66BB6A" Foreground="White" CornerRadius="8" Margin="4,0,0,0" IsEnabled="False"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="娱乐累计" FontSize="14" Foreground="#666"   />
                            
                        <TextBox Name="txtleijiYule" TextAlignment="Center" Height="45" FontSize="18" Grid.Column="1"
                                     IsReadOnly="True" Background="#F5F5F5" Watermark="累计娱乐"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
            </Border>

          


            <!-- 水灌效果 - 成效 -->
            <Border Background="White" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="💧 成效累计" FontSize="16"  Foreground="#555" HorizontalAlignment="Center"/>
                    <Grid Height="180" VerticalAlignment="Center">
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Background="LightGray" Width="200" Height="180" HorizontalAlignment="Center">
                            <Grid>
                                <Grid x:Name="waterContainer" Height="180" VerticalAlignment="Bottom" ClipToBounds="True">
                                    <Border x:Name="waterFill" Height="0" VerticalAlignment="Bottom" CornerRadius="5,5,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#800080" Offset="0"/>
                                                <GradientStop Color="Red" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Canvas x:Name="waveCanvas" Height="10" VerticalAlignment="Bottom">
                                        <Path x:Name="wavePath" Fill="White" Opacity="0.3"
                                              Data="M0,10 C20,0 40,10 60,0 C80,10 100,0 120,10 C140,0 160,10 180,0 C200,10 220,0 240,10 L240,20 L0,20 L0,10"/>
                                    </Canvas>
                                </Grid>
                                <!-- 刻度标签 -->
                                <StackPanel HorizontalAlignment="Left" Margin="5,0,0,0" Spacing="30">
                                    <TextBlock Text="520" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="390" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="260" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="130" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="0" FontSize="10" Foreground="#666"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 水灌效果 - 娱乐 -->
            <Border Background="White" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="💧 娱乐累计" FontSize="16"  Foreground="#555" HorizontalAlignment="Center"/>
                    <Grid Height="180" VerticalAlignment="Center">
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Background="LightGray" Width="200" Height="180" HorizontalAlignment="Center">
                            <Grid>
                                <Grid x:Name="waterContainer2" Height="180" VerticalAlignment="Bottom" ClipToBounds="True">
                                    <Border x:Name="waterFill2" Height="0" VerticalAlignment="Bottom" CornerRadius="5,5,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#800080" Offset="0"/>
                                                <GradientStop Color="Red" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Canvas x:Name="waveCanvas2" Height="10" VerticalAlignment="Bottom">
                                        <Path x:Name="wavePath2" Fill="White" Opacity="0.3"
                                              Data="M0,10 C20,0 40,10 60,0 C80,10 100,0 120,10 C140,0 160,10 180,0 C200,10 220,0 240,10 L240,20 L0,20 L0,10"/>
                                    </Canvas>
                                </Grid>
                                <StackPanel HorizontalAlignment="Left" Margin="5,0,0,0" Spacing="30">
                                    <TextBlock Text="520" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="390" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="260" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="130" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="0" FontSize="10" Foreground="#666"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 水灌效果 - 总积累 -->
            <Border Background="White" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="💧 总累计" FontSize="16"  Foreground="#555" HorizontalAlignment="Center"/>
                    <Grid Height="180" VerticalAlignment="Center">
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Background="LightGray" Width="200" Height="180" HorizontalAlignment="Center">
                            <Grid>
                                <Grid x:Name="waterContainer1" Height="180" VerticalAlignment="Bottom" ClipToBounds="True">
                                    <Border x:Name="waterFill1" Height="0" VerticalAlignment="Bottom" CornerRadius="5,5,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#800080" Offset="0"/>
                                                <GradientStop Color="Red" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Canvas x:Name="waveCanvas1" Height="10" VerticalAlignment="Bottom">
                                        <Path x:Name="wavePath1" Fill="White" Opacity="0.3"
                                              Data="M0,10 C20,0 40,10 60,0 C80,10 100,0 120,10 C140,0 160,10 180,0 C200,10 220,0 240,10 L240,20 L0,20 L0,10"/>
                                    </Canvas>
                                </Grid>
                                <StackPanel HorizontalAlignment="Left" Margin="5,0,0,0" Spacing="30">
                                    <TextBlock Text="63000" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="47250" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="31500" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="15750" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="0" FontSize="10" Foreground="#666"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Margin="5,0,0,0" Spacing="30">
                                    <TextBlock Text="1000h" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="750h" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="500h" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="250h" FontSize="10" Foreground="#666"/>
                                    <TextBlock Text="0" FontSize="10" Foreground="#666"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 学习总累计 -->
            <Border Background="White" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="📚 学习总累计" FontSize="16"  Foreground="#555"/>
                    <Grid ColumnDefinitions="*,2*">
                        <Button Name="Zongjilei" Grid.Column="0" Content="打开总累计" Height="45" FontSize="14"
                                Click="Zongjilei_Click" Background="#90A4AE" Foreground="White" CornerRadius="6" Margin="0,0,4,0"/>
                        <Button Name="ZongjileiJisuan_" Grid.Column="1" Content="总累计保存" Height="45" FontSize="14"
                                Click="ZongjileiJisuan_Click" Background="#78909C" Foreground="White" CornerRadius="6" Margin="4,0,0,0"/>
                    </Grid>
                    <TextBox Name="txtXuexizongjilei" TextAlignment="Center" Height="45" FontSize="18"
                             IsReadOnly="True" Background="#F5F5F5" Watermark="学习总累计"/>
                </StackPanel>
            </Border>

            <!-- 功能按钮区 -->
            <Border Background="White" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="⚙️ 功能操作" FontSize="16"  Foreground="#555"/>
                    <Grid ColumnDefinitions="*,*">
                        <Button Name="Baocun_" Grid.Column="0" Content="💾 保存" Height="50" FontSize="15"
                                Click="Baocun_Click" Background="#4DB6AC" Foreground="White" CornerRadius="8" Margin="0,0,4,0"/>
                        <Button Name="Jiazai_" Grid.Column="1" Content="📂 加载" Height="50" FontSize="15"
                                Click="Jiazai_Click" Background="#4DB6AC" Foreground="White" CornerRadius="8" Margin="4,0,0,0"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*">
                        <Button Name="Mubiao" Grid.Column="0" Content="🎯 目标" Height="50" FontSize="14"
                                Click="Mubiaodakai_Click" Background="#81C784" Foreground="White" CornerRadius="8" Margin="0,0,4,0"/>
                        <Button Name="Shuaxin" Grid.Column="1" Content="🔄 刷新" Height="50" FontSize="14"
                                Click="Shuaxin_Click" Background="#81C784" Foreground="White" CornerRadius="8" Margin="2,0,2,0"/>
                        <Button Name="Huanzhai" Grid.Column="2" Content="🔖 还债" Height="50" FontSize="14"
                                Click="Huanzhai_Click" Background="#FFF59D" Foreground="#333" CornerRadius="8" Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 目标设定区 -->
            <Border Name="MubiaoPanel" Background="White" CornerRadius="8" Padding="12" IsVisible="False">
                <StackPanel Spacing="8">
                    <TextBlock Text="🎯 目标设定" FontSize="16" Foreground="#555"/>

                    <!-- 目标名 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="目标名" FontSize="14" Foreground="#666"/>
                        <TextBox Name="MubiaoNameTextBox" TextAlignment="Center" Height="40" FontSize="16" Background="#FFDFEADB" Watermark="输入目标名"/>
                    </StackPanel>

                    <!-- 目标达到时间 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="目标达到时间（小时）" FontSize="14" Foreground="#666"/>
                        <TextBox Name="MubiaoTimeTextBox" TextAlignment="Center" Height="40" FontSize="16" Background="#FFDFEADB" Watermark="输入小时数"/>
                    </StackPanel>

                    <!-- 比例 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="比例" FontSize="14" Foreground="#666"/>
                        <TextBox Name="MubiaoBiliTextBox" TextAlignment="Center" Height="40" FontSize="16" Background="#FFDFEADB" Watermark="输入比例"/>
                    </StackPanel>

                    <!-- 操作按钮 -->
                    <Grid ColumnDefinitions="*,*,*,*">
                        <Button Name="MubiaoOpenButton" Grid.Column="0" Content="打开" Height="40" FontSize="14"
                                Click="MubiaoOpen_Click" Background="#81C784" Foreground="White" CornerRadius="6" Margin="0,0,4,0"/>
                        <Button Name="MubiaoNewButton" Grid.Column="1" Content="新设置" Height="40" FontSize="14"
                                Click="MubiaoNew_Click" Background="#66BB6A" Foreground="White" CornerRadius="6" Margin="2,0,2,0"/>
                        <Button Name="MubiaoOKButton" Grid.Column="2" Content="确定" Height="40" FontSize="14"
                                Click="MubiaoOK_Click" Background="#4CAF50" Foreground="White" CornerRadius="6" Margin="2,0,2,0"/>
                        <Button Name="MubiaoCancelButton" Grid.Column="3" Content="取消" Height="40" FontSize="14"
                                Click="MubiaoCancel_Click" Background="#EF5350" Foreground="White" CornerRadius="6" Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 目标显示区 -->
            <Border Name="ZimubiaoPanel" Background="White" CornerRadius="8" Padding="12" IsVisible="False">
                <StackPanel Spacing="8">
                    <TextBlock Name="ZimubiaoTitle" Text="🎯 目标显示" FontSize="16" Foreground="#555"/>
                    <TextBox Name="ZimubiaoName" TextAlignment="Center" Height="35" FontSize="16"
                             IsReadOnly="True" Background="#F5F5F5"/>

                    <!-- 目标信息 -->
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="目标预计时间" FontSize="12" Foreground="#666"/>
                            <TextBox Name="ZimubiaoYujiTime" TextAlignment="Center" Height="35" FontSize="14"
                                     IsReadOnly="True" Background="#806D6D" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="目标预计成效" FontSize="12" Foreground="#666"/>
                            <TextBox Name="ZimubiaoYujiCX" TextAlignment="Center" Height="35" FontSize="14"
                                     IsReadOnly="True" Background="#806D6D" Foreground="White"/>
                        </StackPanel>
                    </Grid>

                    <!-- 娱乐和学习时间 -->
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="娱乐时间（小时）" FontSize="12" Foreground="#666"/>
                            <Grid>
                                <TextBox Name="ZimubiaoYuleTime" TextAlignment="Center" Height="35" FontSize="14" Background="#D2CCCC"/>
                                <Button Name="ZimubiaoYuleButton" Content="娱乐" HorizontalAlignment="Right" Margin="0,0,5,0"
                                        Click="ZimubiaoYule_Click" Height="35" Width="50" CornerRadius="4"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="学习时间（分钟）" FontSize="12" Foreground="#666"/>
                            <Grid>
                                <TextBox Name="ZimubiaoXuexiTime" TextAlignment="Center" Height="35" FontSize="14" Background="#D2CCCC"/>
                                <Button Name="ZimubiaoJisuanButton" Content="计算" HorizontalAlignment="Right" Margin="0,0,5,0"
                                        Click="ZimubiaoJisuan_Click" Height="35" Width="50" CornerRadius="4"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- 单次成效 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="单次成效" FontSize="12" Foreground="#666"/>
                        <Grid>
                            <TextBox Name="ZimubiaoDanciCX" TextAlignment="Center" Height="35" FontSize="14"
                                     IsReadOnly="True" Background="#806D6D" Foreground="White"/>
                            <Button Name="ZimubiaoLeijiButton" Content="累计" HorizontalAlignment="Right" Margin="0,0,5,0"
                                    Click="ZimubiaoLeiji_Click" Height="25" Width="50" CornerRadius="4" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>

                    <!-- 当前进度 -->
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="当前成效累计" FontSize="12" Foreground="#666"/>
                            <TextBox Name="ZimubiaoDangqianCX" TextAlignment="Center" Height="35" FontSize="14"
                                     IsReadOnly="True" Background="#806D6D" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <Button Name="ZimubiaoSaveButton" Content="💾 保存目标" Height="35" FontSize="14" Margin="35,17,0,0"
                                    Click="ZimubiaoSave_Click" Background="#4CAF50" Foreground="White" CornerRadius="8"/>
                        </StackPanel>
                    </Grid>

                    <!-- 水灌效果图 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="目标进度" FontSize="14" Foreground="#666" HorizontalAlignment="Center"/>
                        <Grid Height="150" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Background="LightGray" Width="180" Height="150">
                                <Grid>
                                    <Grid Name="waterContainerZimubiao" Height="150" VerticalAlignment="Bottom" ClipToBounds="True">
                                        <Border Name="waterFillZimubiao" Height="0" VerticalAlignment="Bottom" CornerRadius="5,5,0,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#64FF64" Offset="0"/>
                                                    <GradientStop Color="#00B400" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Canvas Name="waveCanvasZimubiao" Height="10" VerticalAlignment="Bottom">
                                            <Path Name="wavePathZimubiao" Fill="White" Opacity="0.3"
                                                  Data="M0,10 C20,0 40,10 60,0 C80,10 100,0 120,10 C140,0 160,10 180,0 C200,10 220,0 240,10 L240,20 L0,20 L0,10"/>
                                        </Canvas>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 底部留白 -->
            <Border Height="20"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
