<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="250"
        x:Class="ChengxiaoA.Views.Mubiaosheding"
        Title="目标设定"
        Width="600"
        Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SystemControlBackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" 
                   Text="目标设定" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <!-- 目标名 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="目标名：" 
                       Width="100" 
                       VerticalAlignment="Center"/>
            <TextBox x:Name="NameTextBox" 
                      Width="200" 
                      BorderBrush="#FF262424"
                      BorderThickness="1"/>
            <TextBlock Text="*" 
                       Foreground="Red" 
                       Margin="5,0" 
                       VerticalAlignment="Center"/>
            <Button Content="打开" 
                    Width="60" 
                    Click="Open_Click"/>
        </StackPanel>

        <!-- 目标达到时间 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="目标达到时间：" 
                       Width="100" 
                       VerticalAlignment="Center"/>
            <TextBox x:Name="TimeTextBox" 
                      Width="100" 
                      BorderBrush="#FF262424"
                      BorderThickness="1"/>
            <TextBlock Text="*小时" 
                       Margin="5,0" 
                       VerticalAlignment="Center"/>
            <Button Content="新设置" 
                    Width="60" 
                    Click="Newmubiao_Click"/>
        </StackPanel>

        <!-- 比例 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="比例：" 
                       Width="100" 
                       VerticalAlignment="Center"/>
            <TextBox x:Name="BiliTextBox" 
                      Width="100" 
                      BorderBrush="#FF262424"
                      BorderThickness="1"/>
        </StackPanel>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,10">
            <Button Content="确定" 
                    Width="80" 
                    Margin="5" 
                    Click="OK_Click"/>
            <Button Content="取消" 
                    Width="80" 
                    Margin="5" 
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
