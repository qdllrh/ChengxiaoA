<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="ChengxiaoA.Views.Zimubiao"
        Width="600"
        Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SystemControlBackgroundBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleTextBlockControl"
                       FontSize="16"
                       FontWeight="Bold"/>
            <TextBox x:Name="Nameizi1"
                      Background="#FFFBF8F8"
                      IsReadOnly="True"
                      Margin="0,5,0,0"
                      FontSize="16"
                      FontWeight="Bold"/>
        </StackPanel>

        <!-- 目标预计时间 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="目标预计时间：" 
                       Width="100" 
                       VerticalAlignment="Center"/>
            <TextBox x:Name="YujiTime" 
                      Width="100" 
                      Background="#FF806D6D" 
                      IsReadOnly="True"/>
            <TextBlock Text="*小时" 
                       Margin="5,0" 
                       VerticalAlignment="Center"/>
            <TextBlock Text="时间" 
                       Width="60" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Margin="10,0"/>
            <TextBox x:Name="YuleTime" 
                      Width="100" 
                      Background="#FFD2CCCC"/>
            <Button Content="娱乐" 
                    Width="60" 
                    Click="YuleJisuan_Click"/>
        </StackPanel>

        <!-- 学习时间 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="学习时间：" 
                       Width="100" 
                       VerticalAlignment="Center"/>
            <TextBox x:Name="XuexiTime" 
                      Width="100" 
                      Background="#FFD2CCCC"/>
            <TextBlock Text="*分钟" 
                       Margin="5,0" 
                       VerticalAlignment="Center"/>
            <Button x:Name="jisuan1_1" 
                    Content="计算" 
                    Width="60" 
                    Click="Jisuan_Click" 
                    IsEnabled="True"/>
            <TextBox x:Name="Dancichengxiao" 
                      Width="100" 
                      Background="#FF806D6D" 
                      IsReadOnly="True" 
                      Margin="5,0"/>
            <Button x:Name="leiji1_1" 
                    Content="累计" 
                    Width="60" 
                    Click="Leiji_Click" 
                    IsEnabled="False" 
                    Margin="5,0"/>
        </StackPanel>

        <!-- 水灌效果图 -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <!-- 水灌效果容器 -->
            <Border BorderBrush="Gray" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Background="LightGray" 
                    Margin="42,19,326,-27"
                    Height="182.24">
                <Grid x:Name="waterContainer" 
                       VerticalAlignment="Bottom" 
                       ClipToBounds="True">
                    <!-- 水效果 -->
                    <Border x:Name="waterFill" 
                            Height="0" 
                            VerticalAlignment="Bottom" 
                            CornerRadius="5,5,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#800080" Offset="0"/>
                                <GradientStop Color="Red" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- 水面波纹效果 -->
                    <Canvas x:Name="waveCanvas"
                            Height="10"
                            VerticalAlignment="Bottom">
                        <Path x:Name="wavePath"
                              Fill="White"
                              Opacity="0.3">
                            <Path.Data>
                                <PathGeometry Figures="M 0,10 C 20,0 40,10 60,0 S 100,10 120,10 S 160,0 180,0 S 220,10 240,10 S 280,0 300,0 S 340,10 360,10 S 400,0 420,0 S 460,10 480,10 L 480,20 L 0,20 Z"/>
                            </Path.Data>
                        </Path>
                    </Canvas>
                </Grid>
            </Border>

            <!-- 当前进度文本框 -->
            <TextBox x:Name="Dancichengxiaoleiji" 
                      Background="#FF806D6D" 
                      IsReadOnly="True" 
                      Margin="285,19,185,128"/>
            <TextBox x:Name="YujiTimeCX" 
                      Background="#FF806D6D" 
                      IsReadOnly="True" 
                      Margin="438,19,32,128"/>
            
            <!-- 保存按钮 -->
            <Button Content="保存" 
                    Click="Save_Click" 
                    Margin="413,82,97,65"/>
        </Grid>
    </Grid>
</Window>
